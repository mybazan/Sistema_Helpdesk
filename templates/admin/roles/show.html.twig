                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input text-bg-primary" name="UBICACION_EDITAR" type="checkbox" id="UBICACION_EDITAR"
                    {% if "UBICACION_EDITAR" in rol.getPermisos() %}checked="true"{% endif %}
                    {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                    <label class="form-check-label" for="UBICACION_EDITAR">Editar</label>
                  </div>
                  <div class="form-check form-switch">
                    <input class="form-check-input text-bg-primary" name="UBICACION_ELIMINAR" data-toggle="toggle" type="checkbox" id="UBICACION_ELIMINAR"
                    {% if "UBICACION_ELIMINAR" in rol.getPermisos() %}checked="true"{% endif %}
                    {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                    <label class="form-check-label" for="UBICACION_ELIMINAR">Eliminar</label>
                  </div>
                  {% if is_granted('ROLES_EDITAR') %}
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                      <button class="btn btn-sm btn-primary me-md-2" type="button" onClick="selectAll('collapseUbicaciones')">Marcar Todo</button>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {# Fin Permisos de Ubicaciones #}

        {# Permisos de Equipo #}
