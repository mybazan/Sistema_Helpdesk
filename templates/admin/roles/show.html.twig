        {# Permisos de Ticket #}
        <div class="col-4">
          <div class="card shadow mb-4">
            <a href="#collapseTicket" class="d-block card-header py-3 collapsed" data-bs-toggle="collapse" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseTicket">
