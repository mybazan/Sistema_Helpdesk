                </div>
                <div class="form-check form-switch">
                  <input class="form-check-input text-bg-primary" name="EQUIPO_ELIMINAR" type="checkbox" id="EQUIPO_ELIMINAR"
                  {% if "EQUIPO_ELIMINAR" in rol.getPermisos() %}checked="true"{% endif %}
                  {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                  <label class="form-check-label" for="EQUIPO_ELIMINAR">Eliminar</label>
                </div>
                <div class="form-check form-switch">
                  <input class="form-check-input text-bg-primary" name="CARACTERISTICA_CREAR" type="checkbox" id="CARACTERISTICA_CREAR"
                  {% if "CARACTERISTICA_CREAR" in rol.getPermisos() %}checked="true"{% endif %}
                  {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
