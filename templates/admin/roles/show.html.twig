                  <input class="form-check-input text-bg-primary" name="TICKET_ELIMINAR" type="checkbox" id="TICKET_ELIMINAR"
                  {% if "TICKET_ELIMINAR" in rol.getPermisos() %}checked="true"{% endif %}
                  {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                  <label class="form-check-label" for="TICKET_ELIMINAR">Eliminar</label>
                </div>
                <div class="form-check form-switch">
                  <input class="form-check-input text-bg-primary" name="TICKET_ASIGNAR" type="checkbox" id="TICKET_ASIGNAR"
                  {% if "TICKET_ASIGNAR" in rol.getPermisos() %}checked="true"{% endif %}
                  {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                  <label class="form-check-label" for="TICKET_ASIGNAR">Asignar</label>
                </div>
                {% if is_granted('ROLES_EDITAR') %}
                  <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button class="btn btn-sm btn-primary me-md-2" type="button" onClick="selectAll('collapseTicket')">Marcar Todo</button>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
        {# Fin Permisos Ticket #}

      </div>
      {% if is_granted('ROLES_EDITAR') %}
        <button class="btn btn-primary float-end" type="submit" >
            Guardar
        </button>
      {% endif %}
    </form>
  </div>

{% endblock rowMain %}

{% block jsBottom %}

<script language="JavaScript">
  function selectAll(source) {
    let first = $('#'+ source + ' input[type=checkbox]')[0].checked;
    $('#'+ source + ' input[type=checkbox]').each(function() {
      $(this).prop('checked', !first)      
    });
  }
</script>

{% endblock %}