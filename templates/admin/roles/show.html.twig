                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input text-bg-primary" name="TIPO_EQUIPO_VER" type="checkbox" id="TIPO_EQUIPO_VER"
                        {% if "TIPO_EQUIPO_VER" in rol.getPermisos() %}checked="true"{% endif %}
                        {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                        <label class="form-check-label" for="TIPO_EQUIPO_VER">Ver</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input text-bg-primary" name="TIPO_EQUIPO_EDITAR" type="checkbox" id="TIPO_EQUIPO_EDITAR"
                        {% if "TIPO_EQUIPO_EDITAR" in rol.getPermisos() %}checked="true"{% endif %}
                        {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                        <label class="form-check-label" for="TIPO_EQUIPO_EDITAR">Editar</label>
                      </div>
                      <div class="form-check form-switch">
                        <input class="form-check-input text-bg-primary" name="TIPO_EQUIPO_ELIMINAR" data-toggle="toggle" type="checkbox" id="TIPO_EQUIPO_ELIMINAR"
                        {% if "TIPO_EQUIPO_ELIMINAR" in rol.getPermisos() %}checked="true"{% endif %}
                        {% if not is_granted('ROLES_EDITAR') %}disabled{% endif %}>
                        <label class="form-check-label" for="TIPO_EQUIPO_ELIMINAR">Eliminar</label>
                      </div>
                      {% if is_granted('ROLES_EDITAR') %}
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                          <button class="btn btn-sm btn-primary me-md-2" type="button" onClick="selectAll('collapseTipoEquipo')">Marcar Todo</button>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
                {# Fin Permisos de Tipo de Equipo #}
                
              </div>
            </div>
          </div>
        </div>
        {# Fin Permisos de Administración #}
        {# Permisos de Ubicaciones #}
          <div class="col-4">
            <div class="card shadow mb-4">
              <a href="#collapseUbicaciones" class="d-block card-header py-3 collapsed" data-bs-toggle="collapse" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseUbicaciones">
                <h6 class="m-0 font-weight-bold text-primary">Permisos en Ubicaciones</h6>
              </a>
              <div class="collapse" id="collapseUbicaciones">
                <div class="card-body">
                  <div class="form-check form-switch">
                    <input class="form-check-input text-bg-primary" name="UBICACION_CREAR" type="checkbox" id="UBICACION_CREAR"
