          <div class="card shadow mb-4">
            <a href="#collapseEstacionTrabajo" class="d-block card-header py-3 collapsed" data-bs-toggle="collapse" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseStock">
              <h6 class="m-0 font-weight-bold text-primary">Permisos en Gestión de Equipo</h6>
            </a>
            <div class="collapse" id="collapseEstacionTrabajo">
              <div class="card-body">
                <div class="form-check form-switch">
                  <input 
                    <input class="form-check-input text-bg-primary" name="EQUIPO_CREAR" type="checkbox" id="EQUIPO_CREAR"
                    {% if "EQUIPO_CREAR" in rol.getPermisos() %}checked="true"{% endif %}
