{% extends 'base/index.html.twig' %}

{% block title %}Gestión de Tipos de Equipos{% endblock %}

{% block headerMain %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-dark"><b>Lista de Tipos de Equipos</b></h1>
        {% if is_granted('TIPO_EQUIPO_CREAR') %}
            <div class="align-items-center justify-content-end">
                <a href="{{ path('tipo_equipo_new') }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
                    <i class="fa fa-plus"></i> &nbsp; Nuevo Tipo de Equipo
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}


{% block rowMain %}
    <div class="col">

        {{ include('admin/tipo_equipo/_filtro.html.twig', {'form': formFiltros}) }}

        <div class="table-responsive mt-3">
            <table class="display table table-hover" >
                {# Títulos de tabla #}
                <thead>
                    {# IDENTIFICACIÓN #}
                    <th scope="col" class="font-weight-semi-bold py-2" style="cursor: auto;" width="40%">
                        <div>
                            {{ knp_pagination_sortable(pagination, 'Tipo de Equipo', 't.nombre') }}  &nbsp;
                            {% if pagination.getSort == 't.nombre' and pagination.getDirection == 'asc' %}
                                <i class="fas fa-caret-up"></i>
                            {% elseif pagination.getSort == 't.nombre' and pagination.getDirection == 'desc' %}
                                <i class="fas fa-caret-down"></i>
                            {% endif %}
                        </div>
                    </th>
                    {# NOMENCLATURA #}
                    <th scope="col" class="font-weight-semi-bold py-2" style="cursor: auto;" width="20%">
                        <div class="align-middle text-center">
                            {{ knp_pagination_sortable(pagination, 'Nomenclatura', 't.nomenclatura') }}  &nbsp;
                            {% if pagination.getSort == 't.nomenclatura' and pagination.getDirection == 'asc' %}
                                <i class="fas fa-caret-up"></i>
                            {% elseif pagination.getSort == 't.nomenclatura' and pagination.getDirection == 'desc' %}
                                <i class="fas fa-caret-down"></i>
                            {% endif %}
                        </div>
                    </th>
                    {# ESTÁ ACTIVO #}
                    <th scope="col" class="font-weight-semi-bold py-2" style="cursor: auto;">
                        <div class="text-center">
                            {{ knp_pagination_sortable(pagination, 'Estado', 't.isActive') }}  &nbsp;
                            {% if pagination.getSort == 't.isActive' and pagination.getDirection == 'asc' %}
                                <i class="fas fa-caret-up"></i>
                            {% elseif pagination.getSort == 't.isActive' and pagination.getDirection == 'desc' %}
                                <i class="fas fa-caret-down"></i>
                            {% endif %}
                        </div>
                    </th>
                </thead>
                {# END Títulos de tabla #}

                {# Contenido de tabla #}
                <tbody>
                    {% for tipo in pagination %}
                        <tr 
                            {% if is_granted('TIPO_EQUIPO_ELIMINAR') or is_granted('TIPO_EQUIPO_EDITAR') %}
                                data-bs-toggle="modal"
                                data-bs-target="#modalAction{{tipo.id}}"
                                class="td-cursor cursorPointer"
                            {% endif %}
                        >

                            <td class="align-middle ">{{ tipo.nombre }}</td>
                            <td class="align-middle text-center">{{ tipo.nomenclatura|default('-') }}</td>
                            <td class="align-middle text-center">{{ tipo.estadoLabel }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                {# END Contenido de tabla #}

            </table>
        </div>

        {# Paginación #}
        <div class="row justify-content-between m-0 w-100 mt-2">
            <div class="col-4">
                <div class="d-flex mb-2 mb-md-0 d-inline-flex">
                    {{ pagination.getTotalItemCount }} {{ pagination.getTotalItemCount == 1 ? " registro" : " registros" }} en total
                </div>
            </div>
            <div class="col-4 text-end">
                <div class="d-inline-flex align-items-end">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
        {# END Paginación #}

    </div>
{% endblock %}

{% block modal_content %}
    {% for tipo in pagination %}
        {{ include('admin/tipo_equipo/_modal_action_form.html.twig', { 'tipo': tipo } ) }}
    {% endfor %}
{% endblock modal_content %}