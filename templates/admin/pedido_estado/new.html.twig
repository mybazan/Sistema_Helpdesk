{% extends "base/index.html.twig" %}

{% block headerMain %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0 text-dark"><b>{% if currentPath == 'pedido_estado_new' %}Nuevo{% else %}Editar{% endif %} estado</b></h1>
        <div class="align-items-center justify-content-end">
          <a href="{{ path('pedido_estado_index') }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fa fa-reply"></i> &nbsp; Volver al listado
          </a>
        </div>        
    </div>
{% endblock %}

{% block rowMain %}
  <div class="col">
    <div class="card">
        <div class="card-body">
            {{ include('admin/pedido_estado/_form.html.twig') }}
        </div>
    </div>
  </div>
{% endblock rowMain %}