{% extends "base/index.html.twig" %}

{% block headerMain %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
      <h1 class="h4 mb-0 text-dark"><b>{% if currentPath != 'app_admin_edit_user' %}Nuevo{% else %}Editar{% endif %} usuario</b></h1>
      <div class="align-items-center justify-content-end">
        <a href="{{ path('app_admin_users') }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
          <i class="fa fa-reply"></i> &nbsp; Volver al listado
        </a>
      </div>        
    </div>
{% endblock %}

{% block rowMain %}
  <div class="col">
    <div class="card">
        <div class="card-body">
            {{ form_start(userForm) }}
                {{ form_widget(userForm) }}
                <p class="mt-3 fw-light">Los campos marcados con * deben ser completados.</p>
                <hr>
                <div class="form-group mt-2 d-flex justify-content-end">
                  <button type="submit" name="valider" class="btn btn-sm btn-outline-primary float-end">Guardar</button>
                </div>
            {{ form_end(userForm) }}
        </div>
    </div>
  </div>
{% endblock rowMain %}