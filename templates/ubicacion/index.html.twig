{% extends 'base/index.html.twig' %}

{% block title %}Ubicaciones{% endblock %}

{% block headerMain %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-dark"><b>Ubicaciones</b></h1>
        {% if is_granted('UBICACION_CREAR') %}
            <div class="align-items-center justify-content-end">
                <a href="{{ path('ubicacion_new') }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
                    <i class="fa fa-plus"></i> &nbsp; Nueva
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block rowMain %}
    <div class="col">
        <div class="table-responsive mt-3">
            <table class="display table table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Nomenclatura</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" width="120">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for ubicacion in ubicaciones %}
                        <tr>
                            <td class="align-middle">
                                <a href="{{ path('ubicacion_show', {'id': ubicacion.id}) }}" class="text-decoration-none">
                                    {{ ubicacion.nombre }}
                                </a>
                            </td>
                            <td class="align-middle">{{ ubicacion.nomenclatura }}</td>
                            <td class="align-middle text-center">{{ ubicacion.estadoLabel }}</td>
                            <td class="align-middle text-center">
                                {% if is_granted('UBICACION_EDITAR') %}
                                    <a href="{{ path('ubicacion_edit', {'id': ubicacion.id}) }}" class="btn btn-primary btn-sm" title="Editar">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">No hay ubicaciones registradas.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
