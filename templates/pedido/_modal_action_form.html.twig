{# MODAL ASIGNAR - FORMULARIO #}
{% if is_granted('TICKET_EDITAR') %}
  <div class="modal fade" id="modalAsignar{{pedido.id}}" tabindex="-1" aria-labelledby="modalAsignarLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="{{ path('ticket_edit_estado', {'id': pedido.id, 'accion': 'asignar'}) }}" method="post" enctype="multipart/form-data">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="modalAsignarLabel">{{ pedido.tecnicoAsignado is null ? 'Asignar ' : 'Reasignar ' }}Ticket Nº{{ pedido.id }}</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            {% if pedido.tecnicoAsignado is not null %}
              <div class="mb-3">
                Esta por reasignar el <b>ticket de soporte Nº{{ pedido.id }}</b>.<br>
                Esta acción corresponde aplicar cuando el ticket tendrá otro encargado.
              </div>
            {% endif %}
            <div class="mb-3">
              <select class="form-select" aria-label="Default select example" name="inputTecnico">
                {% set opciones = tecnicos | filter(item => item != pedido.tecnicoAsignado) %}
                {% for asignadoEquipo in pedido.pedidoTecnicoAsignados %}
                  {% if asignadoEquipo.esOperativo == true %}
                    {% set opciones = opciones | filter(item => item != asignadoEquipo.tecnicoAsignado) %}
                  {% endif %}
                {% endfor %}
                {% if opciones %}
                  <option selected>Seleccionar un encargado.</option>
                  {% for tecnico in opciones %}
                    <option value={{tecnico.id}}>{{ tecnico.apellido~", "~tecnico.nombre }}</option>
                  {% endfor %}
                {% else %}
                  <option selected>No hay técnicos disponibles.</option>
                {% endif %}
              </select>
            </div>
            {% if pedido.tecnicoAsignado is null %}
              <div class="mb-3">
                <label for="inputObservacion" class="form-label">Observación</label>
                <input type="text" class="form-control" id="inputObservacion" name="inputObservacionAsignar" placeholder="Ingresar una anotación para el estado...">
              </div>
            {% endif %}
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-2"></i>Cancelar</button>
            <button type="submit" class="btn btn-primary" onclick="disableButtonAfterSubmit(this);">Confirmar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endif %}

