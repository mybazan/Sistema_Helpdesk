{# MODAL EQUIPO - FORMULARIO #}
{% if is_granted('TICKET_EDITAR') %}
  <div class="modal fade" id="modalEquipo{{pedido.id}}" tabindex="-1" aria-labelledby="modalEquipoLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="{{ path('ticket_edit_equipo', {'id': pedido.id}) }}" method="post" enctype="multipart/form-data">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="modalEquipoLabel">Equipo de Trabajo para Ticket Nº{{ pedido.id }}</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              Esta por {{ pedido.pedidoTecnicoAsignados is empty ? 'asignar' : 'reasignar' }} un equipo al <b>ticket de soporte Nº{{ pedido.id }}</b>.<br>
              Esta acción corresponde aplicar cuando el ticket tendrá un equipo de trabajo.<br>
            </div>
            <div class="mb-3 ms-3">
              {% for tecnico in tecnicos %}
                {% if tecnico != pedido.tecnicoAsignado %}
                  <div class="form-check-{{ tecnico.id }}">
                    <input class="form-check-input" name="check{{ tecnico.id }}" type="checkbox" value={{ tecnico.id }} id="flexCheck{{ tecnico.id }}" 
                      {% for asignadoEquipo in pedido.pedidoTecnicoAsignados %}
                        {% if tecnico == asignadoEquipo.tecnicoAsignado and asignadoEquipo.esOperativo %}
                          checked
                        {% endif %}
                      {% endfor %}
                    >
                    <label class="form-check-label" for="flexCheck{{ tecnico.id }}">
                      {{ tecnico.apellido~", "~tecnico.nombre }}
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-2"></i>Cancelar</button>
            <button type="submit" class="btn btn-primary" onclick="disableButtonAfterSubmit(this);">Confirmar</button>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endif %}
