<div class="modal fade" id="modalAction{{pedido.id}}" aria-hidden="true" aria-labelledby="modalActionLabel" tabindex="-1">
  {% set estadoActual = pedido.estadoActualNombre %}
  {% set puedeGestionar = pedido.tecnicoAsignado == usuario or is_granted('TICKET_ASIGNAR') %}
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalActionLabel">Acciones sobre el Ticket Nº{{ pedido.id }}</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>¿Qué acción desea realizar sobre el ticket de soporte Nº{{ pedido.id }}?</p>
      </div>
      <div class="modal-footer justify-content-md-center">
        <span>
          <button class="btn btn-primary" onClick="window.location='{{ path('ticket_show', {'id': pedido.id}) }}'"><i class="far fa-eye me-2"></i>Ver Detalles</button> 
          {% if is_granted('TICKET_EDITAR') and (is_granted('TICKET_ASIGNAR') or not app.user.isTecnico) and estadoActual != 'Finalizado' %}
              <button class="btn btn-primary" onClick="window.location='{{ path('ticket_edit', {'id': pedido.id}) }}'"><i class="fas fa-pen me-2"></i>
                Editar
              </button>
          {% endif %}

          {% if is_granted('TICKET_ELIMINAR') and estadoActual in ['Recibido', 'Desestimado'] %}
            <button class="btn btn-primary" data-bs-target="#modalActionDelete{{pedido.id}}" data-bs-toggle="modal"><i class="fa fa-trash me-2"></i>Eliminar</button>
          {% endif %}
        </span>
        <hr>
        
        <span class="text-center">
          {% if is_granted('TICKET_EDITAR') and estadoActual is not null %}

            {% if estadoActual == "Recibido" and is_granted('TICKET_ASIGNAR') %}
              <button class="btn btn-primary" data-bs-target="#modalActionDesestimar{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-archive me-2"></i>Desestimar</button>
            {% endif %}

            {% if estadoActual != "Demorado" and estadoActual != "Finalizado" and estadoActual != "Desestimado" and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalActionDemorar{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hourglass-half me-2"></i>Demorar</button>
            {% endif %}

            {% if estadoActual == "Demorado" and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalActionQuitarDemora{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-undo me-2"></i>Continuar</button>
            {% endif %}

            {% if estadoActual == "Recibido" and is_granted('TICKET_ASIGNAR') %}
              <button class="btn btn-primary" data-bs-target="#modalAsignar{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hands-helping me-2"></i>Asignar</button>
            {% endif %}

            {% if estadoActual in ["Asignado", "Pendiente", "En Proceso"] and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalEquipo{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-users-cog me-2"></i>Equipo</button>
            {% endif %}

            {% if ( estadoActual == "Pendiente" or estadoActual == "Asignado" ) and pedido.tecnicoAsignado is not null and is_granted('TICKET_ASIGNAR') %}
              <button class="btn btn-primary" data-bs-target="#modalAsignar{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hands-helping me-2"></i>Reasignar</button>
            {% endif %}

            {% if ( estadoActual == "Pendiente" or estadoActual == "Asignado" ) and puedeGestionar %}
              <button class="btn btn-primary {{ is_granted('TICKET_ASIGNAR') and pedido.tecnicoAsignado == usuario ? 'mt-2' }}" data-bs-target="#modalEnProceso{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hammer me-2"></i>En Proceso</button>
            {% endif %}

            {% if ( estadoActual == "Asignado" or estadoActual == "En Proceso" ) and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalPendiente{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-pause me-2"></i>Pendiente</button>
            {% endif %}

            {% if estadoActual == "En Proceso" and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalResuelto{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hammer me-2"></i>Resolver</button>
            {% endif %}

            {% if estadoActual == "Resuelto" and puedeGestionar %}
              <button class="btn btn-primary" data-bs-target="#modalFinalizado{{pedido.id}}" data-bs-toggle="modal"><i class="fas fa-hammer me-2"></i>Finalizar</button>
            {% endif %}

          {% endif %}
        </span>
      </div>
    </div>
  </div>
</div>

{# MODAL ELIMINAR #}
{% if is_granted('TICKET_ELIMINAR') %}
  <div class="modal fade" id="modalActionDelete{{pedido.id}}" aria-hidden="true" aria-labelledby="modalActionDeleteLabel" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="modalActionDeleteLabel">Eliminar Ticket Nº{{ pedido.id }}</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>Está por eliminar el <b>ticket de soporte Nº{{ pedido.id }}</b>.<br></p>
          <p><i class="fas fa-info-circle me-2 text-primary"></i>Esta acción no podrá realizarse si el mismo se encuentra en tratamiento o finalizado.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-primary" data-bs-target="#modalAction{{pedido.id}}" data-bs-toggle="modal">Volver</button>
            <button class="btn btn-danger" type="submit" onClick="window.location='{{ path('ticket_delete', {'id': pedido.id}) }}'"><i class="fa fa-trash me-2"></i>Confirmar</button>
        </div>
      </div>
    </div>
  </div>
{% endif %}

