{% extends "base/index.html.twig" %}

{% block title %}Ayuda{% endblock %}

{% block headerMain %}
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-dark"><b>Preguntas frecuentes</b></h1>
        <div class="align-items-center justify-content-end">
          <a href="{{ path('inicio_index') }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
            {% if app.user is empty %}
              <i class="fa fa-reply"></i> &nbsp; Volver
            {% else %}
              <i class="fa fa-reply"></i> &nbsp; Volver a Inicio
            {% endif %}
          </a>
        </div>
    </div>
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h6 class="h6 ms-4 mb-0 text-dark">¿Tienes alguna duda sobre el funcionamiento del sistema?</h6>
    </div>

{% endblock %}

{% block rowMain %}

  <div class="accordion" id="accordionExample">
    {% if is_granted('TICKET_VER') %}
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingTickets">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTicketsHelp" aria-expanded="false" aria-controls="collapseTicketsHelp">
            <i class="fas fa-receipt me-2"></i>Tickets de soporte
          </button>
        </h2>
        <div id="collapseTicketsHelp" class="accordion-collapse collapse" aria-labelledby="headingTickets" data-bs-parent="#accordionExample">
          <div class="accordion-body">
            <p>El módulo de tickets permite registrar y dar seguimiento a solicitudes de soporte técnico.</p>
            <ul>
              <li><b>Coordinador</b> (permiso Asignar): ve todos los tickets, los crea, asigna o reasigna a técnicos, y puede cambiar cualquier estado (Desestimado, Demorado, En Proceso, Resuelto, Finalizado).</li>
              <li><b>Técnico</b>: solo ve los tickets que le fueron asignados y puede marcarlos como Pendiente, En Proceso, Demorado, Resuelto o Finalizado.</li>
            </ul>
            <p><b>Flujo habitual:</b> Recibido → Asignado → En Proceso → Resuelto → Finalizado.</p>
            <p>También se puede marcar como Pendiente (en espera), Demorado o Desestimado según corresponda.</p>
          </div>
        </div>
      </div>
    {% endif %}

    {% if is_granted('EQUIPO_VER') %}
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingEquipos">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEquiposHelp" aria-expanded="false" aria-controls="collapseEquiposHelp">
            <i class="fas fa-desktop me-2"></i>Equipos y planilla
          </button>
        </h2>
        <div id="collapseEquiposHelp" class="accordion-collapse collapse" aria-labelledby="headingEquipos" data-bs-parent="#accordionExample">
          <div class="accordion-body">
            <p>Desde la ficha de un equipo puede cargar la <b>Planilla del Equipo</b>: marca, modelo, procesador, memoria, almacenamiento, sistemas operativos y accesos, según el tipo.</p>
            <p>Esa planilla es la fuente de datos para la vista del equipo y para la exportación a PDF.</p>
          </div>
        </div>
      </div>
    {% endif %}

    {% if is_granted('USERS_VER') or is_granted('ROLES_VER') or is_granted('ADMINISTRACION') %}
      <div class="accordion-item">
        <h2 class="accordion-header" id="headingThree">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThreeHelp" aria-expanded="false" aria-controls="collapseThreeHelp">
            <i class="fa fa-cog me-2"></i>Administración
          </button>
        </h2>
        <div id="collapseThreeHelp" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionExample">
          <div class="accordion-body">
            El apartado de Administración permite gestionar usuarios, roles, permisos, ubicaciones y catálogos.
            {{ include('inicio/help-administracion.html.twig') }}
          </div>
        </div>
      </div>
    {% endif %}

    <div class="accordion-item">
      <h2 class="accordion-header" id="headingFour">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFourHelp" aria-expanded="false" aria-controls="collapseFourHelp">
          <i class="fas fa-lock me-2"></i>Contraseña
        </button>
      </h2>
      <div id="collapseFourHelp" class="accordion-collapse collapse" aria-labelledby="headingFour" data-bs-parent="#accordionExample">
        <div class="accordion-body">
          El apartado Contraseña permite configurar su clave de acceso al sistema.
          {{ include('inicio/help-contrasenia.html.twig') }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
