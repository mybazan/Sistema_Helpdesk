{% extends 'base/index-alone.html.twig' %}

{% block title %}Recuperación de contraseña{% endblock %}

{% block contenido %}
	<div class="container">
		<div class="row justify-content-center h-100">
			<div class="col-xxl-4 col-xl-5 col-lg-5 col-md-7 col-sm-9">
				<div class="card shadow-lg">
					<div class="card-footer py-2 pt-3 border-0 text-center">
						<h1 class="fs-4 text-dark">Sistema de Soporte</h1>
					</div>
					<div class="card-body p-5 pb-2 pt-2">
						<h1 class="fs-5 card-title fw-bold mb-3 mt-2">Recuperar contraseña</h1>
						<p class="sub-recuperar card-text" style="text-align: justify;">
							Verifique su casilla de correo electrónico para encontrar el enlace de restablecimiento de contraseña.
							Este enlace caducará en <b>{{ tokenLifetime|date('g') }} horas.</b>
						</p>
						<p style="text-align: justify;">
							Si no recibe el correo electrónico, consulte su carpeta de spam o correo no deseado. En su defecto <a class="text-secondary" href="{{ path('app_forgot_password_request') }}"><b>
							intente nuevamente</b></a>.
						</p>
						<hr>
						<a href="{{ path('inicio_index') }}" class="btn btn-primary my-2 inputLoggin w-100" id="btnIngresar">Iniciar Sesión</a>
					</div>
					<div class="card-footer py-1 border-0">
						<div class="text-center text-muted">
							Gestión de tickets e inventario técnico
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}