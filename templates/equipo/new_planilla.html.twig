{% extends "base/index.html.twig" %}

{% block title %}Planilla de Equipo{% endblock %}

{% block headerMain %}
	<div class="d-sm-flex align-items-center justify-content-between mb-4">
		<h1 class="h4 mb-0 text-dark">
			<b>
				{% if currentPath == 'new_planilla_equipo' %}
					Nueva Planilla del Equipo:
				{% else %}
					Editar Planilla del Equipo:
				{% endif %}
				{{equipo.nombre}}
			</b>
		</h1>
		<div class="align-items-center justify-content-end">
			<a href="{{ path('show_equipo', {'id': equipo.id}) }}" class="d-md-inline-block btn btn-sm btn-primary shadow-sm">
				<i class="fa fa-reply"></i>
				&nbsp; Volver
			</a>
		</div>
	</div>
{% endblock %}

{% block rowMain %}
	<div class="col">
		<div class="card">
			<div class="card-body">
				{% embed template %}{% endembed %}
			</div>
		</div>
	</div>
{% endblock rowMain %}
