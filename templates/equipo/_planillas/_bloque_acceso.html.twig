{% if equipo.planillaEquipo.accesos is not empty %}
	<div class="accordion mb-3" id="accordionAccesosGenerales">
		<div class="accordion-item">
			<h2 class="accordion-header" id="headingAccesosGenerales">
				<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAccesosGenerales" aria-expanded="false" aria-controls="collapseAccesosGenerales">
					<div class="d-flex align-items-center">
						<div class="fw-semibold">Accesos</div>
					</div>
				</button>
			</h2>
			<div id="collapseAccesosGenerales" class="accordion-collapse collapse" aria-labelledby="headingAccesosGenerales" data-bs-parent="#accordionAccesosGenerales">
				<div class="accordion-body">
					<div class="table-responsive">
						<table class="table table-hover align-middle">
							<thead class="text-center">
								<tr>
									<th>Aplicación</th>
									<th>Usuario</th>
									<th>Contraseña</th>
									<th>Observación</th>
								</tr>
							</thead>
							<tbody>
								{% for acceso in equipo.planillaEquipo.accesos %}
									<tr class="text-center">
										<td>{{ acceso.aplicacion|default('-') }}</td>
										<td>{{ acceso.usuario|default('-') }}</td>
										<td>{{ acceso.clave|default('-') }}</td>
										<td>{{ acceso.observacion|default('-') }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}
