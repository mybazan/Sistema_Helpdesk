<div class="d-sm-flex align-items-center justify-content-between">
	<h1 class="h5 mb-0 text-dark mb-3">
		<b>Sistemas Operativos y Accesos</b>
	</h1>
</div>
<div class="accordion" id="accordionSistemasOperativos">
	{% for sistemaOperativo in equipo.planillaEquipo.sistemasOperativos %}
		<div class="accordion-item mb-3 bg-white rounded-3 overflow-hidden {% if not loop.first %}border-top border-secondary border-opacity-25{% endif %}">

			<h2 class="accordion-header" id="heading-{{ loop.index }}">
				<button class="accordion-button collapsed bg-gradient bg-opacity-10" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-{{ loop.index }}" aria-expanded="false" aria-controls="collapse-{{ loop.index }}">
					<div class="d-flex align-items-center">
						<div class="fw-semibold">{{ sistemaOperativo.nombre }}
							{{ sistemaOperativo.version|default('') }}</div>
					</div>
				</button>
			</h2>
			<div id="collapse-{{ loop.index }}" class="accordion-collapse collapse" aria-labelledby="heading-{{ loop.index }}" data-bs-parent="#accordionSistemasOperativos">
				<div class="accordion-body">
					<div class="row g-3 mb-4">
						<div class="table-responsive mt-3 pb-2">
							<table class="table">
								<tbody>
									<tr>
										<th width="150" class="text-end">Observación:</th>
										<td class="align-middle">{{ sistemaOperativo.observacion|default('-') }}</td>
									</tr>
								</tbody>
							</table>
						</div>

						<div class="mt-1">
							<div class="d-sm-flex align-items-center justify-content-between">
								<h1 class="h5 mb-0 text-dark mb-1">
									<b>Accesos</b>
								</h1>
							</div>
							<div class="table-responsive">
								<table class="display table table-hover">
									<thead>
										<tr class="text-center">
											<th>Aplicación</th>
											<th>Usuario</th>
											<th>Contraseña</th>
											<th>Observación</th>
										</tr>
									</thead>
									<tbody>
										{% if sistemaOperativo.accesos is not empty %}
											{% for acceso in sistemaOperativo.accesos %}
												<tr class="text-center">
													<td>{{ acceso.aplicacion }}</td>
													<td>{{ acceso.usuario|default('-') }}</td>
													<td>{{ acceso.clave|default('-') }}</td>
													<td>{{ acceso.observacion|default('-') }}</td>
												</tr>
											{% endfor %}
										{% else %}
											<tr class="text-center">
												<td colspan="4" class="text-center">
													<i class="bi bi-cloud-slash"></i>
													<p class="mb-0">No se encontraron accesos para este sistema operativo</p>
												</td>
											</tr>
										{% endif %}
									</tbody>
								</table>
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>

	{% else %}
		<div class="text-center">
			<i class="bi bi-cloud-slash"></i>
			<p class="mb-0">No se encontraron sistemas operativos</p>
		</div>
	{% endfor %}
</div>