{% block javascripts %}
	{{ encore_entry_script_tags('componente_app') }}
	{% for file in encore_entry_js_files('componente_app') %}
		<script type="text/javascript" src="{{ asset(file) }}" async="false"></script>
	{% endfor %}
{% endblock %}
