{% import _self as _selfMacro %}
{{ form_start(form) }}
{{ include('equipo/_form/_form_planilla.html.twig', { 'form': form }) }}

{# Campos de Sistema Operativo #}
	{{ include('equipo/_form/_form_sistema_operativo.html.twig', {'form': form}) }}

{# Campos específicos de la PC #}
<div class="col mb-1">
	{{ form_label(form.procesador) }}
	{{ form_widget(form.procesador) }}
</div>

{# Campos de almacenamiento #}
{{ include('equipo/_form/_form_almacenamiento.html.twig', {'form': form}) }}

<div class="col mb-1">
	{{ form_label(form.memoriaRAM) }}
