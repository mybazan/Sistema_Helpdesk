<form method="post" action="{{ path('personal_delete', {'id': personal.id}) }}" onsubmit="return confirm('¿Eliminar este personal?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ personal.id) }}">
    <input type="hidden" name="_method" value="DELETE">
    <button class="btn btn-danger">Eliminar</button>
</form>
